generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum RequestStatus {
  SUBMITTED
  UNDER_REVIEW
  QUOTED
  QUOTE_REJECTED
  AWAITING_PAYMENT
  PAID
  PURCHASED
  SHIPPED_TO_WAREHOUSE
  IN_TRANSIT_INTL
  IN_CUSTOMS
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  passwordHash    String
  name            String
  phone           String?
  role            Role              @default(CUSTOMER)
  addresses       Address[]
  requests        PurchaseRequest[] @relation("CustomerRequests")
  handledRequests PurchaseRequest[] @relation("StaffHandler")
  quotesCreated   Quote[]           @relation("QuoteCreatedBy")
  statusEvents    StatusEvent[]     @relation("StatusEventActor")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("users")
}

model Address {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  label          String?
  addressLine    String
  city           String
  state          String?
  postalCode     String?
  country        String
  referencePoint String?
  phone          String
  isDefault      Boolean           @default(false)
  requests       PurchaseRequest[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([userId])
  @@map("addresses")
}

model PurchaseRequest {
  id                     String        @id @default(cuid())
  customerId             String
  customer               User          @relation("CustomerRequests", fields: [customerId], references: [id])
  assignedStaffId        String?
  assignedStaff          User?         @relation("StaffHandler", fields: [assignedStaffId], references: [id])
  productUrl             String?
  description            String
  quantity               Int           @default(1)
  estimatedDeclaredValue Decimal?      @db.Decimal(10, 2)
  destinationAddressId   String
  destinationAddress     Address       @relation(fields: [destinationAddressId], references: [id])
  status                 RequestStatus @default(SUBMITTED)
  notes                  String?
  quotes                 Quote[]
  payments               Payment[]
  events                 StatusEvent[]
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([customerId])
  @@index([assignedStaffId])
  @@index([status])
  @@map("purchase_requests")
}

model Quote {
  id                 String           @id @default(cuid())
  purchaseRequestId  String
  purchaseRequest    PurchaseRequest  @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  itemCost           Decimal          @db.Decimal(10, 2)
  serviceFee         Decimal          @db.Decimal(10, 2)
  intlShippingCost   Decimal          @db.Decimal(10, 2)
  estimatedDuty      Decimal          @db.Decimal(10, 2)
  dutyCalcSnapshot   Json
  totalAmount        Decimal          @db.Decimal(10, 2)
  currency           String           @default("USD")
  expiresAt          DateTime?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  createdByStaffId   String
  createdByStaff     User             @relation("QuoteCreatedBy", fields: [createdByStaffId], references: [id])
  payments           Payment[]
  createdAt          DateTime         @default(now())

  @@index([purchaseRequestId])
  @@map("quotes")
}

model Payment {
  id                  String          @id @default(cuid())
  purchaseRequestId   String
  purchaseRequest     PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])
  quoteId             String
  quote               Quote           @relation(fields: [quoteId], references: [id])
  amount              Decimal         @db.Decimal(10, 2)
  provider            String
  providerRef         String?
  status              PaymentStatus   @default(PENDING)
  confirmedByStaffId  String?
  proofOfPaymentUrl   String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([purchaseRequestId])
  @@index([quoteId])
  @@map("payments")
}

model StatusEvent {
  id                String          @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  fromStatus        RequestStatus?
  toStatus          RequestStatus
  actorUserId       String?
  actor             User?           @relation("StatusEventActor", fields: [actorUserId], references: [id])
  note              String?
  createdAt         DateTime        @default(now())

  @@index([purchaseRequestId])
  @@map("status_events")
}

model Brand {
  id        String           @id @default(cuid())
  name      String           @unique
  slug      String           @unique
  isActive  Boolean          @default(true)
  sortOrder Int              @default(0)
  products  CatalogProduct[]
  createdAt DateTime         @default(now())

  @@map("brands")
}

model CatalogProduct {
  id          String                  @id @default(cuid())
  brandId     String
  brand       Brand                   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name        String
  description String?
  imageUrl    String?
  images      String[]                @default([])
  price       Decimal?                @db.Decimal(10, 2)
  weightGrams Int?
  productUrl  String?
  isActive    Boolean                 @default(true)
  variants    CatalogProductVariant[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([brandId, isActive])
  @@map("catalog_products")
}

// A variant (e.g. one color + storage combo) of a CatalogProduct. When a
// product has variants, the public catalog lets the customer pick one and
// swaps price/images accordingly instead of showing the product's own
// price/imageUrl, which stay as the fallback for variant-less products.
model CatalogProductVariant {
  id         String         @id @default(cuid())
  productId  String
  product    CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  color      String?
  capacity   String?
  imageUrl   String?
  images     String[]       @default([])
  price      Decimal?       @db.Decimal(10, 2)
  productUrl String?
  isActive   Boolean        @default(true)
  sortOrder  Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([productId, isActive])
  @@map("catalog_product_variants")
}

model DutyRateConfig {
  id            String    @id @default(cuid())
  category      String
  ratePercent   Decimal   @db.Decimal(5, 2)
  minThreshold  Decimal?  @db.Decimal(10, 2)
  flatFee       Decimal?  @db.Decimal(10, 2)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  @@index([category, isActive])
  @@map("duty_rate_configs")
}

model ShippingRateConfig {
  id            String    @id @default(cuid())
  category      String
  ratePerKg     Decimal   @db.Decimal(10, 2)
  minCharge     Decimal?  @db.Decimal(10, 2)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  @@index([category, isActive])
  @@map("shipping_rate_configs")
}
